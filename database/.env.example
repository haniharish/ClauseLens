# =============================================================================
# ClauseLens Database Environment Configuration Example (.env.example)
# Copy this file to .env and fill in secure local/runtime values.
# NEVER commit a real .env file or real passwords to GitHub.
# =============================================================================

DB_ENGINE=django.db.backends.postgresql
DB_NAME=clauselens_db
DB_USER=clauselens_app
DB_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

# Optional connection URL (used by SQLAlchemy / test runners if needed)
DATABASE_URL=postgresql://clauselens_app:CHANGE_ME_USE_STRONG_PASSWORD@localhost:5432/clauselens_db
