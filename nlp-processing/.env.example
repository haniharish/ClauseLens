# ============================================================
# ClauseLens NLP Service — Environment Configuration Example
# Copy to .env and fill in your values. NEVER commit .env.
# ============================================================

# --- Service ---
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8001

# --- Models ---
# Embedding model (HuggingFace Sentence Transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# spaCy model for NLP preprocessing
SPACY_MODEL=en_core_web_sm

# --- LLM Summarization Provider ---
# Supported: openai | google | anthropic | mock
LLM_PROVIDER=openai

# Your LLM API key — KEEP SECRET
LLM_API_KEY=replace_with_your_api_key

# LLM model name for the selected provider
# OpenAI  → gpt-4o-mini  | gpt-4o
# Google  → gemini-1.5-flash | gemini-1.5-pro
# Anthropic → claude-3-haiku-20240307
LLM_MODEL=gpt-4o-mini

# Base URL override (useful for OpenAI-compatible endpoints / Azure)
LLM_BASE_URL=

# --- File Limits ---
MAX_DOCUMENT_SIZE_MB=20

# --- Classification ---
# Options: rule_based | zero_shot | hybrid
CLASSIFICATION_METHOD=hybrid

# Zero-shot model (used if method is zero_shot or hybrid)
ZERO_SHOT_MODEL=facebook/bart-large-mnli

# --- Performance ---
# Set to 1 to avoid heavy model downloads (uses rule-based + mock LLM)
LIGHTWEIGHT_MODE=0

# Embedding batch size
EMBEDDING_BATCH_SIZE=32

# --- Integration ---
# Django backend base URL (used for reference only — NLP service is called BY Django)
DJANGO_BACKEND_URL=http://localhost:8000

# NLP service internal URL (for documentation)
NLP_SERVICE_URL=http://localhost:8001
