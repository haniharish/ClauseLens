# Environment Variables for ClauseLens Backend
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.

# Django Core
DEBUG=True
SECRET_KEY=replace_with_a_long_random_secret_key_here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DATABASE_NAME=clauselens_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Redis (Celery Broker)
REDIS_URL=redis://localhost:6379/0

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# External Microservice URLs
NLP_SERVICE_URL=http://localhost:8001
PERSONALIZATION_SERVICE_URL=http://localhost:8002
VERSION_SERVICE_URL=http://localhost:8003

# Internal Service Authentication Token
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_SERVICE_TOKEN=replace_with_secure_internal_token

# JWT Settings (seconds)
ACCESS_TOKEN_LIFETIME=3600
REFRESH_TOKEN_LIFETIME=86400

# File Upload
MAX_UPLOAD_SIZE_MB=10
MEDIA_ROOT=media/

# Alert Threshold (0.0 - 1.0)
ALERT_THRESHOLD=0.5

# Email (optional — leave blank to disable during development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@clauselens.com

# Mock Mode (use mock adapters when real services are unavailable)
USE_MOCK_NLP=True
USE_MOCK_PERSONALIZATION=True
USE_MOCK_VERSION=True
